# Variable names only. Set values in your local .env.local (git-ignored).
MVM_OPERATOR_TOKEN=
MVM_BIND=127.0.0.1:5199
MVM_ALLOWED_ORIGINS=http://localhost:5198,http://127.0.0.1:5198,tauri://localhost,http://tauri.localhost
MVM_S3_ENDPOINT=
MVM_S3_BUCKET=
MVM_S3_REGION=us-east-1
MVM_S3_ACCESS_KEY=
MVM_S3_SECRET_KEY=
# Optional song analysis; the key stays on the coordinator and is injected from BWS.
ESSENTIA_API_BASE_URL=
# ESSENTIA_API_KEY=
# Local development only; enables local assets and permits anonymous loopback API.
# MVM_DEV_LOCAL=1
# Server-only; used only when the operator requests lyrics extraction.
# DEEPGRAM_API_KEY=
CONVEX_SELF_HOSTED_URL=
MVVM_CONVEX_SELF_HOSTED_ADMIN_KEY=
